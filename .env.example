# Copier en .env (jamais commité). start.ps1 génère ORCHESTRA_TOKEN automatiquement.
ORCHESTRA_TOKEN=

# Clés API gratuites (optionnelles, laisser vide si non utilisées)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Alertes e-mail (optionnel, désactivé par défaut dans config.yaml)
SMTP_PASSWORD=
